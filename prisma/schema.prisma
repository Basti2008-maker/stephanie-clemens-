generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Rsvp {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  // Zweite Person, wenn sich ein Paar gemeinsam anmeldet.
  partnerFirstName String?
  partnerLastName  String?
  email     String
  phone     String
  street    String
  zipCode   String
  city      String
  country   String
  createdAt DateTime @default(now())
}

// Sicherung der Anmeldungen. Wird vor jedem Zuruecksetzen angelegt, damit
// keine Daten verloren gehen. Wird nie automatisch geloescht.
model Sicherung {
  id        String   @id @default(cuid())
  grund     String
  anzahl    Int
  daten     String // JSON der gesicherten Zeilen
  createdAt DateTime @default(now())
}

// Fehlgeschlagene Admin-Anmeldungen, um Passwort-Raten zu bremsen.
model LoginVersuch {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}
